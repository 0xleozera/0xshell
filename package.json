{
  "name": "sshell",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "sshell": "./index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 ./index.ts --outfile dist/sshell-darwin-arm64",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 ./index.ts --outfile dist/sshell-linux-x64",
    "build": "bun run build:darwin-arm64 && bun run build:linux-x64"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "zod": "^4.4.3"
  }
}
