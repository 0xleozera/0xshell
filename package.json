{
  "name": "0xshell",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "0xshell": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 ./src/index.ts --outfile dist/0xshell-darwin-arm64",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 ./src/index.ts --outfile dist/0xshell-linux-x64",
    "build": "bun run build:darwin-arm64 && bun run build:linux-x64"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "citty": "^0.2.2",
    "zod": "^4.4.3"
  }
}
